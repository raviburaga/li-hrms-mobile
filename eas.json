{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "environment": "development",
      "developmentClient": true,
      "android": {
        "distribution": "internal"
      },
      "env": {
        "EXPO_PUBLIC_API_ORIGIN": "https://hrms-appi.raviburaga.shop"
      }
    },
    "development-simulator": {
      "environment": "development",
      "developmentClient": true,
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_API_ORIGIN": "https://hrms-appi.raviburaga.shop"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_ORIGIN": "http://103.140.18.28:5000"
      }
    },
    "production": {
      "channel": "production",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_ORIGIN": "http://103.140.18.28:5000"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
