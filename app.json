{
  "expo": {
    "name": "li-hrms-mobile",
    "slug": "li-hrms-mobile",
    "scheme": "li-hrms",
    "version": "1.0.0",
    "runtimeVersion": "1.0.13",
    "updates": {
      "url": "https://u.expo.dev/a6df1916-5889-4ffa-a22f-ba617c936e61",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lihrms.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.lihrms.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to attach photo evidence for on-duty requests.",
          "cameraPermission": "Allow $(PRODUCT_NAME) to take a photo for on-duty evidence."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow $(PRODUCT_NAME) to record your location with on-duty requests, matching the workspace.",
          "locationAlwaysAndWhenInUsePermission": "Allow $(PRODUCT_NAME) to record your on-duty GPS route in the background until you submit OD OUT. Required when the screen is off or you use other apps during on-duty.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#10B981",
          "sounds": []
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "a6df1916-5889-4ffa-a22f-ba617c936e61"
      }
    },
    "owner": "raviburaga"
  }
}
